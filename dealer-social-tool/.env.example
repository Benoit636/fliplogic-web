# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public URL of the app (used in emails, OAuth redirects and Stripe return links)
APP_URL=http://localhost:3000
# Long random string. REQUIRED in production — it encrypts customers' social tokens. Never change it after launch.
APP_SECRET=
PRODUCT_NAME=Dealer Social
SUPPORT_EMAIL=support@yourdomain.com
# Your email(s): unlock the /admin console (customers, MRR, comped plans)
SUPERADMIN_EMAILS=
DATABASE_PATH=./data/dealer-social.db
BACKUP_DIR=./data/backups
# Uploaded vehicle photos (served publicly at /media so social networks can fetch them)
MEDIA_DIR=./data/media
TRIAL_DAYS=14
# Self-serve signup (anyone can create a dealership). Defaults to off in production:
# dealerships are created with `npm run create-dealer` and staff join by invite. Set to 1 to open it.
ALLOW_SIGNUP=
# Pilot: 1 switches off social connections, the inbox (customer messages), AI chat, autopilot and billing,
# and makes new dealerships complimentary. Use 1 for the Volkswagen Moncton pilot.
PILOT_MODE=1
# Sign out after this many hours without activity (default 336 = 14 days). Use 12 for shared showroom computers.
SESSION_IDLE_HOURS=

# ─── AI (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
SCHEDULER_INTERVAL_SECONDS=30

# ─── Billing (Stripe) — run `npm run stripe:setup` to fill the price IDs ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_YEARLY=
# STRIPE_CURRENCY=usd
# STRIPE_AUTOMATIC_TAX=1

# ─── Email (Resend) — without a key emails are printed to the console ───
RESEND_API_KEY=
EMAIL_FROM=Dealer Social <no-reply@yourdomain.com>

# ─── Social network apps (enable the "Connect" buttons) ─────────────────
# Redirect URL to register with each network: {APP_URL}/oauth/{meta|google|linkedin|x|tiktok}/callback
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=202608
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

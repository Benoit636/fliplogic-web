# Server
PORT=3000
# Optional: protect the dashboard with HTTP Basic auth (user: admin)
ADMIN_PASSWORD=
# SQLite database location
DATABASE_PATH=./data/dealer-social.db

# AI bot (Claude). Without a key the tool still runs using built-in templates.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Background workers
SCHEDULER_INTERVAL_SECONDS=30

# Meta (Facebook Pages + Instagram Business) webhooks for real-time comments
META_VERIFY_TOKEN=
META_APP_SECRET=
